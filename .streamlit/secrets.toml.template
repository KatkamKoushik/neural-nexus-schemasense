# Streamlit secrets template for SchemaSense
# Copy this file to .streamlit/secrets.toml for local development or enter into
# Streamlit Community Cloud (App Settings -> Secrets).
# NEVER commit secrets.toml to version control.

# Google Gemini API Keys
GEMINI_KEYS = ["your-gemini-api-key-1", "your-gemini-api-key-2"]
# OR single key:
# GEMINI_API_KEY = "your-single-gemini-api-key"

# Built-in Streamlit Community Cloud OIDC Authentication (Google Sign-In)
# Generate cookie_secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
[auth]
redirect_uri = "https://YOUR-REAL-APP.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Optional database connections (can also be entered dynamically in the sidebar UI)
[connections.postgresql]
dialect = "postgresql"
host = "your-postgres-host"
port = "5432"
database = "your-database-name" 
username = "schemasense_readonly" 
password = "your-password"

[connections.mysql]
dialect = "mysql"
driver = "pymysql"
host = "your-mysql-host"
port = 3306
database = "your-database-name"
username = "schemasense_readonly"
password = "your-password"